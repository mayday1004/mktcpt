{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# /config.js is generated by docker-entrypoint.sh from Railway env vars.
	# Keep it un-cached so changing SHEETS_* or YOURLS_WAKE_* only needs a restart.
	@runtimeConfig path /config.js
	header @runtimeConfig Cache-Control "no-cache"

	@html path *.html
	header @html Cache-Control "no-cache"

	@assets path /app.js /styles.css
	header @assets Cache-Control "public, max-age=3600"

	# version.txt:長 tab 偵測新 deploy 用,必須讀到最新內容
	@version path /version.txt
	header @version Cache-Control "no-cache"

	file_server
}

{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	file_server

	@html path *.html
	header @html Cache-Control "no-cache"

	@assets path *.js *.css
	header @assets Cache-Control "public, max-age=3600"

	@config path /config.js
	header @config Cache-Control "no-cache"

	# version.txt:長 tab 偵測新 deploy 用,必須讀到最新內容
	@version path /version.txt
	header @version Cache-Control "no-cache"
}
